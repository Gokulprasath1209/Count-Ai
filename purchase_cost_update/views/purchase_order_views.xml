<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Purchase Order Form View -->
    <record id="purchase_order_form_inherit_sl_no" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.sl.no</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="before">
                <field name="sl_no" width="50px" readonly="1" force_save="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="project_id" required="1"/>
            </xpath>
        </field>
    </record>
</odoo>

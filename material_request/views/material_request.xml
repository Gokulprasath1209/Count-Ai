<odoo>
    <data>
        <record model="ir.ui.view" id="material_request_form">
            <field name="name">Material.Request.form</field>
            <field name="model">material.request</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_approve" type="object" string="Approve" class="btn-primary"
                                groups="material_request.group_material_request"
                                invisible="state in ['onhand_approve','full_approve']"/>
                        <button name="action_purchase_request" type="object" string="Purchase Request"
                                groups="material_request.group_material_request"
                                invisible="state in ['waiting_for_purchase','onhand_approve','full_approve']"
                                class="btn-primary"/>
                        <button name="action_receive_product" type="object" string="Receive Product"
                                invisible="product_accept_bool"
                                groups="material_request.group_mrp"
                                class="btn-primary"/>
                        <button name="action_ceo_approve" type="object" string="Approve"
                                class="btn-success" groups="sale_extended.group_ceo"
                                invisible="approve_type in ['ceo','ceo_reject']"/>
                        <button name="action_ceo_reject" type="object" string="Reject"
                                class="btn-danger" groups="sale_extended.group_ceo"
                                invisible="approve_type in ['ceo','ceo_reject']"/>
                        <button name="action_user_receive_product" type="object" string="Receive Product"
                                invisible="not same_user_bool or user_product_accept_bool"
                                class="btn-primary"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="alert alert-success mb-4" role="alert" invisible="not product_accept_bool">
                            This Components Received By Manufacture Department.....!!!
                        </div>
                        <div class="alert alert-success mb-4" role="alert" invisible="not user_product_accept_bool">
                            This Components Received By Respondent User.....!!!
                        </div>
                        <div class="alert alert-success mb-4" role="alert" invisible="approve_type != 'ceo'">
                            This User Material Request has been approved By CEO.....!!!
                        </div>
                        <div class="alert alert-danger mb-4" role="alert" invisible="approve_type != 'ceo_reject'">
                            This User Material Request has been Reject By CEO.....!!!
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_purchase_request" groups="material_request.group_material_request"
                                    class="oe_stat_button"
                                    icon="fa-book"
                                    type="object"
                                    invisible="not purchase_request_count">
                                <field name="purchase_request_count" widget="statinfo" string="Purchase Request"/>
                            </button>
                            <button name="action_material_request_backorder"
                                    groups="material_request.group_material_request"
                                    class="oe_stat_button"
                                    icon="fa-repeat"
                                    type="object"
                                    invisible="not backorder_count">
                                <field name="backorder_count" widget="statinfo" string="Back orders"/>
                            </button>
                            <button name="action_open_stock_picking"
                                    groups="material_request.group_material_request"
                                    class="oe_stat_button"
                                    icon="fa-book"
                                    type="object"
                                    invisible="not stock_picking_count">
                                <field name="stock_picking_count" widget="statinfo" string="Stock Picking"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="main_mrp_id" readonly="1" invisible="request_type != 'mrp'"/>
                                <field name="ref" readonly="1" invisible="request_type == 'mrp'"/>
                                <field name="user_id" readonly="1"/>
                                <field name="same_user_bool"/>
                                <field name="backorder_name" invisible="1" readonly="1"/>
                                <field name="order_type" invisible="1"/>
                                <field name="request_type" invisible="1"/>
                                <field name="approve_type" invisible="1"/>
                            </group>
                            <group>
                                <field name="display_date" readonly="1"/>
                                <field name="product_accept_bool" invisible="1"/>
                                <field name="user_product_accept_bool" invisible="1"/>
                                <field name="dest_loc_id"
                                       invisible="request_type != 'user'"
                                       required="request_type == 'user'"/>
                                <field name="procurement_ids" widget="many2many_tags"
                                       invisible="request_type == 'user'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Components" name="components">
                                <field name="request_line_ids" readonly="state in ['onhand_approve','full_approve']">
                                    <list string="Components" editable="bottom" create="false" delete="false">
                                        <field name="serial_no"/>
                                        <field name="product_id" readonly="1"/>
                                        <field name="total_stock"/>
                                        <field name="demand_qty"
                                               attrs="{'readonly': [('request_id.state', '!=', 'draft')]}"/>
                                        <!--                                        <field name="demand_qty" readonly="1"/>-->
                                        <field name="approve_qty"/>
                                    </list>
                                </field>
                            </page>
                            <page name="note" string="Note">
                                <group>
                                    <field name="note" required="1" readonly="request_type == 'user'"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="material_request_list">
            <field name="name">Material.Request.list</field>
            <field name="model">material.request</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="main_mrp_id"/>
                    <field name="ref"/>
                    <field name="display_date"/>
                    <field name="state"
                           widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-success="state in ('waiting_for_purchase', 'onhand_approve', 'full_approve', 'received')"/>
                    <button name="action_ceo_approve" type="object" string="Approve"
                            class="btn-success" groups="sale_extended.group_ceo"
                            invisible="approve_type in ['ceo','ceo_reject']"/>
                    <button name="action_ceo_reject" type="object" string="Reject"
                            class="btn-danger" groups="sale_extended.group_ceo"
                            invisible="approve_type in ['ceo','ceo_reject']"/>

                </list>
            </field>
        </record>

        <record id="view_material_search" model="ir.ui.view">
            <field name="name">material.request.search</field>
            <field name="model">material.request</field>
            <field name="arch" type="xml">
                <search string="Material Indent Search">
                    
                    <field name="name"
                           string="Search All"
                           filter_domain="['|', '|', '|', '|', '|', '|',
                                          ('name', 'ilike', self),
                                          ('ref', 'ilike', self),
                                          ('user_id.name', 'ilike', self),
                                          ('main_mrp_id.name', 'ilike', self),
                                          ('note', 'ilike', self),
                                          ('request_line_ids.product_id.name', 'ilike', self),
                                          ('request_line_ids.product_id.default_code', 'ilike', self)]"/>
                    
                    <field name="user_id"
                           string="Request User"
                           filter_domain="[('user_id.name', 'ilike', self)]"/>
                    
                    <field name="ref" 
                           string="Reference"
                           filter_domain="[('ref', 'ilike', self)]"/>
                    
                    <field name="main_mrp_id" 
                           string="MRP Order"
                           filter_domain="[('main_mrp_id.name', 'ilike', self)]"/>
                    
                    <field name="note" 
                           string="Project ID"
                           filter_domain="[('note', 'ilike', self)]"/>
                    
                    <separator/>
                    
                    <filter string="Waiting for CEO" name="user_request_type"
                            domain="[('request_type','=','user'),('approve_type','=','draft')]"
                            help="User requests waiting for CEO approval"/>
                    <filter string="Waiting for Store" name="request_type" 
                            domain="[('request_type','=','mrp')]"
                            help="MRP requests waiting for store"/>
                    <filter string="Accepted by CEO" name="approve_type" 
                            domain="[('approve_type','=','ceo')]"
                            help="Requests accepted by CEO"/>
                    <filter string="Reject by CEO" name="reject_type" 
                            domain="[('approve_type','=','ceo_reject')]"
                            help="Requests rejected by CEO"/>
                    
                    <separator/>
                    
                    <filter string="Draft" name="filter_draft"
                            domain="[('state','=','draft')]"/>
                    <filter string="Waiting for Purchase" name="filter_waiting_purchase" 
                            domain="[('state','=','waiting_for_purchase')]"/>
                    <filter string="On Hand Approved" name="filter_onhand" 
                            domain="[('state','=','onhand_approve')]"/>
                    <filter string="Full Approved" name="filter_full_approve" 
                            domain="[('state','=','full_approve')]"/>
                    <filter string="Received" name="filter_received" 
                            domain="[('state','=','received')]"/>
                    
                    <separator/>
                    
                    <group expand="0" string="Group By">
                        <filter name="group_by_user" string="Request User" context="{'group_by': 'user_id'}"/>
                        <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_by_type" string="Request Type" context="{'group_by': 'request_type'}"/>
                        <filter name="group_by_approve" string="Approval Type" context="{'group_by': 'approve_type'}"/>
                    </group>
                    
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="material_request_action_window">
            <field name="name">Material Request</field>
            <field name="res_model">material.request</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_user_request_type': 1}</field>
            <field name="help" type="html">
                <br/>
                <h2>
                    Material Request For Production!!!
                </h2>
            </field>
        </record>


        <menuitem name="Material Request" id="material_request_menu"
                  web_icon="material_request,static/descripition/material_request.png"
                  action="material_request_action_window"/>

    </data>
</odoo>
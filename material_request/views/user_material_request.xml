<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_user_material_request_list" model="ir.ui.view">
            <field name="name">user.material.request.list</field>
            <field name="model">user.material.request</field>
            <field name="arch" type="xml">
                <list string="User Material Requests">
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="date"/>
                    <field name="exception_date"/>
                    <field name="location_id"/>
                    <field name="state"
                           widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-success="state == 'send'"
                           decoration-primary="state == 'received'"/>

                    <!--                    <field name="price_subtotal"/>-->
                </list>
            </field>
        </record>

        <record id="view_user_material_request_search" model="ir.ui.view">
            <field name="name">user.material.request.search</field>
            <field name="model">user.material.request</field>
            <field name="arch" type="xml">
                <search string="User Material Requests">

                    <field name="product_search_id"
                           string="Product"
                           filter_domain="[('line_ids.product_id', '=', self)]"/>
                    <field name="user_id"/>
                    <field name="state"/>
                    <field name="location_id"/>

                </search>
            </field>
        </record>


        <record id="view_user_material_request_form" model="ir.ui.view">
            <field name="name">user.material.request.form</field>
            <field name="model">user.material.request</field>
            <field name="arch" type="xml">
                <form string="User Material Request">
                    <header>
                        <button name="action_request" type="object" string="Send Store" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_receive" type="object" string="Receive" class="btn-success"
                                invisible="state == 'received'"/>
                        <button name="action_cancel" type="object" string="Cancel" class="btn-danger"
                                invisible="state == 'cancel'"/>
                        <!--                        <button name="action_return_material" type="object" string="Return Material" class="btn-warning"-->
                        <!--                                invisible="state != 'received'"/>-->
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_material_request"
                                    class="oe_stat_button"
                                    icon="fa-book"
                                    type="object"
                                    invisible="not material_request_count">
                                <field name="material_request_count" widget="statinfo" string="Material Request"/>
                            </button>

                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="user_id" readonly="1" options="{'no_open': True, 'no_create': True}"/>
                                <field name="date"/>
                                <!--                                <field name="location_id" required="1" readonly="state == 'send'"/>-->
                            </group>
                            <group>
                                <field name="location_id" required="1" readonly="state == 'send'"/>
                                <field name="exception_date"/>
<!--                                <field name="received_by" required="1"/>-->
                                <!--                                <field name="user_id" readonly="1"/>-->
                                <!--                                <field name="date" readonly="state == 'send'"/>-->
                            </group>
                            <group>
                                <!--                                <field name="location_id" required="1" readonly="state == 'send'"/>-->
                                <!--                                <field name="exception_date" required="1" readonly="state == 'send'"/>-->
                                <!--                                <field name="location_from_id" invisible="1"/>-->
                                <!--                                <field name="location_id" invisible="1"/>-->
                                <field name="warehouse_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Materials">
                                <field name="line_ids" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="product_uom_id"/>
                                        <field name="unit_price"/>
                                        <field name="price_subtotal"/>

                                        <!--                                        <field name="received_qty"-->
                                        <!--                                               column_invisible="parent.state != 'received'"/>-->

                                        <!--                                        <field name="used_qty"-->
                                        <!--                                               column_invisible="parent.state != 'received'"/>-->

                                        <!--                                        <field name="return_qty"-->
                                        <!--                                               column_invisible="parent.state != 'received'"/>-->
                                    </list>
                                </field>

                                <group class="oe_subtotal_footer oe_right">
                                    <field name="total_amount"
                                           readonly="1"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </page>
                            <page name="note" string="Project ID">
                                <group>
                                    <field name="note" required="1" readonly="state == 'send'"/>
<!--                                    <field name="description" required="1" readonly="state == 'send'"/>-->
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_user_material_request" model="ir.actions.act_window">
            <field name="name">User Material Requests</field>
            <field name="res_model">user.material.request</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('user_id','=',uid)]</field>

        </record>

        <menuitem
                id="menu_user_material_request_root"
                name="User Material Requests"
                web_icon="material_request,static/descripition/user_material.png"
                action="action_user_material_request"
                sequence="20"/>

    </data>
</odoo>

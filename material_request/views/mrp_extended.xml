<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_inherit" model="ir.ui.view">
        <field name="name">product.template.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="product_type" groups="material_request.group_mrp"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_filter_inherit_project" model="ir.ui.view">
        <field name="name">mrp.production.select.inherit.project</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter string="Project" name="project" domain="[]" context="{'group_by': 'project_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_order_form_inherit" model="ir.ui.view">
        <field name="name">mrp.production.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="action_request" type="object" class="oe_highlight" string="Material Request"
                        invisible="material_request in ['send']"/>
                <button name="action_again_request" type="object" class="oe_highlight" string="Material Request"
                        invisible="material_request not in ['send'] or state == 'done'"/>
                <button name="action_quality_request" type="object" class="oe_highlight" string="Send Quality"
                        invisible="quality_test_count"
                />

            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_material_request"
                        type="object"
                        string="Material Request"
                        class="oe_stat_button"
                        icon="fa-gear"
                        invisible="not material_request_count">
                    <field name="material_request_count" widget="statinfo" string="Material Request"/>
                </button>
                <button name="action_open_quality_request"
                        type="object"
                        string="Quality"
                        class="oe_stat_button"
                        icon="fa-check-square-o"
                        invisible="not quality_test_count">
                    <field name="quality_test_count" widget="statinfo" string="Quality"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='lot_producing_id']" position="after">
                <field name="mrp_unique_ref" placeholder="Enter Unique Reference" required="state in ['to_close']"/>
            </xpath>

            <xpath expr="//field[@name='user_id']" position="after">
                <field name="material_request_ids" widget="many2many_tags" invisible="1"/>
                <field name="request_for_material" readonly="1" widget="radio" options="{'horizontal': True}"/>
                <field name="material_request" invisible="1" widget="radio" options="{'horizontal': True}"/>
            </xpath>

            <xpath expr="//field[@name='product_id']" position="before">
                <field name="project_id" placeholder="Select Project" required="1"/>
            </xpath>

            <xpath expr="//page[@name='miscellaneous']" position="after">
                <page name="note" string="Note">
                    <group>
                        <field name="note" required="1"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>


    <record id="view_inherit_purchase_requisition" model="ir.ui.view">
        <field name="name">purchase.requisition.inherit</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(purchase_requisition.action_purchase_requisition_to_so)d']"
                   position="replace">
                <button name="%(purchase_requisition.action_purchase_requisition_to_so)d" type="action"
                        string="New Quotation" class="btn-primary" groups="material_request.group_purchase"
                        context="{'default_currency_id': currency_id, 'default_user_id': user_id}"
                        invisible="state != 'confirmed'"/>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="replace">
                <button name="action_cancel"
                        groups="material_request.group_purchase" invisible="state not in ('draft', 'confirmed')"
                        string="Cancel" type="object"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="replace">
                <div class="oe_button_box" name="button_box">
                    <button name="%(purchase_requisition.action_purchase_requisition_list)d" type="action"
                            class="oe_stat_button"
                            icon="fa-list-alt" groups="material_request.group_purchase"
                            invisible="state == 'draft'" context="{'default_currency_id': currency_id}">
                        <field name="order_count" widget="statinfo" string="RFQs/Orders"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_mrp_bom_form_inherit_s_no" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.s.no</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']//field[@name='product_id']" position="before">
                <field name="s_no"/>
            </xpath>
        </field>
    </record>

</odoo>
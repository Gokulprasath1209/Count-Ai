<odoo>
    <record id="view_purchase_request" model="ir.ui.view">
        <field name="name">purchase.request.wizard</field>
        <field name="model">purchase.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Request For Material">
                <div class="alert alert-success mb-4" role="alert">
                    This is Purchase Request For Inventory Department please Kindly Check Product And Qty!!!!
                </div>
                <group>
                    <group>
                        <field name="partner_id" invisible="1"/>
                        <field name="material_request_id" readonly="1"/>
                    </group>
                    <group>

                    </group>
                </group>
                <notebook>
                    <page string="Components" name="components">
                        <field name="products_lines">
                            <list string="Components" editable="bottom" create="false" delete="false">
                                <field name="product_id" readonly="1" force_save="1"/>
                                <field name="purchase_qty" readonly="0"/>
                            </list>
                        </field>
                    </page>

                </notebook>
                <footer>
                    <button string="Purchase Request" name="save_button" type="object" class="btn-primary"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>

            </form>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchaseorder_reports_wizard_report_action_new" model="ir.actions.report">
            <field name="name">Purchase Order Report</field>
            <field name="model">purchaseorder.reports.wizard</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">purchase_wizard.template_purchase_report_qweb</field>
            <field name="report_file">purchase_wizard.template_purchase_report_qweb</field>
        </record>


        <template id="template_purchase_report_qweb">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Purchase Order Report</h2>
                        <div id="informations" class="row mb-4">
                            <div class="col">
                                <strong>Start date</strong>
                                <div t-esc="start_date"/>
                            </div>
                            <div class="col">
                                <strong>End date</strong>
                                <div t-esc="end_date"/>
                            </div>
                            <div class="col">
                                <strong>Raised By</strong>
                                <div t-esc="user.name"/>
                            </div>
                        </div>
                        <table class="table table-bordered"
                               style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                            <thead>
                                <tr>
                                    <t t-foreach="data['header']" t-as="header">
                                        <th style="text-align:center;">
                                            <t t-esc="header"/>
                                        </th>
                                    </t>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-set="l_index" t-value="1"/>
                                <t t-set="l_total" t-value="0"/>
                                <t t-foreach="data['purchase_value']" t-as="line">
                                    <tr>
                                        <td style="text-align:center;">
                                            <t t-esc="l_index"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="line['order_id'].name"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="line['partner_id'].name"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="line['date']"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="line['product'].default_code"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="line['product'].name"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="line['product_qty']"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="line['received_qty']"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="line['unit_price']"/>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="line['tax_price']"/>
                                            <t t-set="l_total" t-value="l_total+line['tax_price']"/>
                                        </td>

                                    </tr>
                                    <t t-set="l_index" t-value="l_index+1"/>

                                </t>
                                <tr>
                                    <td style="text-align:center;" colspan="6">
                                        <strong>Total</strong>
                                    </td>
                                    <td style="text-align:center;">
                                        <strong><t t-esc="data['total_qty']"/></strong>
                                    </td>
                                    <td style="text-align:center;">
                                        <strong><t t-esc="data['total_received']"/></strong>
                                    </td>
                                    <td style="text-align:center;">
                                    </td>
                                    <td style="text-align:center;">
                                        <strong><t t-esc="data['total_amount']"/></strong>
                                    </td>
                                </tr>


                            </tbody>
                        </table>

                    </div>
                </t>
            </t>


        </template>

    </data>
</odoo>


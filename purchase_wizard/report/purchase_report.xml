<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="paper_format_purchase_report_pdf" model="report.paperformat">
            <field name="name">Purchase PDF Report</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">25</field>
            <field name="margin_bottom">27</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">10</field>
            <field name="dpi">90</field>
        </record>

        <record id="purchaseorder_reports_wizard_report_action_new" model="ir.actions.report">
            <field name="name">Purchase Order Report</field>
            <field name="model">purchaseorder.reports.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">purchase_wizard.template_purchase_report_qweb</field>
            <field name="report_file">purchase_wizard.template_purchase_report_qweb</field>
            <field name="paperformat_id" ref="purchase_wizard.paper_format_purchase_report_pdf"/>
            <field name="print_report_name">'Purchase_Order_Report_%s' % (object.start_date or '')</field>
        </record>


        <template id="template_purchase_report_qweb">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">


                    <t t-if="res_company and res_company.logo">
                        <div style="text-align:left; margin-bottom:20px;">
                            <img t-att-src="'data:image/png;base64,%s' % res_company.logo.decode()"
                                 style="max-height:80px; max-width:200px;"/>
                        </div>
                    </t>

                    <h2 style="text-align:center; color:#7f609d; margin-bottom:20px;">
                        Purchase Order Report
                    </h2>

                    <t t-foreach="report_data" t-as="line">
                        <table class="table table-sm table-bordered"
                               style="width:100%; border-collapse:collapse; margin-bottom:10px;">
                            <thead style="background-color:#7f609d; color:white;">
                                <tr>
                                    <th>PO Number</th>
                                    <th>PO Date</th>
                                    <th>Responsible</th>
                                    <th>Vendor</th>
                                    <th>Product</th>
                                    <th>Ordered Qty</th>
<!--                                    <th>Received Qty</th>-->
<!--                                    <th>Balance Qty</th>-->
                                    <th>Unit Price</th>
                                    <th>Total Price</th>
<!--                                    <th>Expected Receipt</th>-->
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <span t-esc="line.get('po_number')"/>
                                    </td>
                                    <td>
                                        <span t-esc="line.get('po_date')"/>
                                    </td>
                                    <td>
                                        <span t-esc="line.get('responsible')"/>
                                    </td>
                                    <td>
                                        <span t-esc="line.get('vendor')"/>
                                    </td>
                                    <td>
                                        <span t-esc="line.get('product_name')"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="line.get('ordered_qty')"/>
                                    </td>
<!--                                    <td class="text-right">-->
<!--                                        <span t-esc="line.get('received_qty')"/>-->
<!--                                    </td>-->
<!--                                    <td class="text-right">-->
<!--                                        <span t-esc="line.get('balance_qty')"/>-->
<!--                                    </td>-->
                                    <td class="text-right">
                                        <span t-esc="line.get('unit_price')"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="line.get('total_price')"/>
                                    </td>
<!--                                    <td>-->
<!--                                        <span t-esc="line.get('expected_receipt_date')"/>-->
<!--                                    </td>-->
                                    <td>
                                        <span t-esc="line.get('delivery_status')"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>

                </t>
            </t>
        </template>

    </data>
</odoo>

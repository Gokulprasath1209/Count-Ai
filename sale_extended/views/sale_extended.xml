<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_config_to_approval" model="ir.ui.view">
        <field name="name">sale_approval_config_settings_view_form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pricing_setting_container']" position="inside">
                <setting id="approved_range" help="Enable Sale Or Spare Approved">
                    <field name="sale_approval"/>
                    <div class="content-group" invisible="not sale_approval">
                        <div class="mt16">
                            <label for="cto_approved_range" class="o_light_label me-2"/>
                            <field name="cto_approved_range"/>
                            <label for="ceo_approved_range" class="o_light_label me-2"/>
                            <field name="ceo_approved_range"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_send_approve" type="object" string="Send Approve Request" class="btn-primary"
                        invisible="approval_state in ['to_approve','cto_approved','ceo_approved','rejected']"/>
                <button name="action_cto_approve" type="object" string="Approve" class="btn-success"
                        groups="sale_extended.group_cto" invisible="state == 'sale'"/>
                <button name="action_ceo_approve" type="object" string="Approve" class="btn-success"
                        groups="sale_extended.group_ceo" invisible="state == 'sale' or approval_state == 'ceo_approved'"/>
                <button name="action_request" string="Send Request To Store" type="object" class="oe_highlight"
                        invisible="sale_or_spare != 'spare' or not show_store_request_button or state == 'cancel'"/>
                <button name="action_confirm_spare" string="Complete Order" type="object" class="btn-success"
                        invisible="sale_or_spare != 'spare' or product_return != 'returnable' or approval_state != 'ceo_approved' or state not in ['draft', 'sent'] or not is_return_validated"/>
                <button name="action_acknowledge_receipt" string="Transfer Items" type="object" class="btn-info"
                        invisible="sale_or_spare != 'spare' or state == 'cancel' or not show_store_request_button"/>
                <button name="action_accept_transfer" string="Accept Items" type="object" class="btn-warning"
                        invisible="sale_or_spare != 'spare' or not has_pending_acknowledgement"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning text-center o_form_header" role="alert"
                     invisible="sale_or_spare != 'spare' or product_return != 'returnable' or approval_state != 'ceo_approved' or state not in ['draft', 'sent'] or is_return_validated">
                    <strong>Kindly return the product and complete the sale order...</strong>
                </div>
                <div class="alert alert-info text-center o_form_header" role="alert"
                     invisible="sale_or_spare != 'spare' or not has_pending_acknowledgement">
                    <strong>You have items waiting to be accepted. Please check the items and click "Accept Items".</strong>
                </div>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="string">Order Date</attribute>
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='date_order']" position="after">
                <field name="sale_or_spare" widget="radio" options="{'horizontal': True}" readonly="1"/>
                <field name="contact_person_id" readonly="0"/>
                <field name="approval_state" widget="radio" options="{'horizontal': True}" readonly="1"/>
                <field name="product_return" widget="radio" options="{'horizontal': True}" invisible="sale_or_spare != 'spare'" required="sale_or_spare == 'spare'" readonly="state == 'sale'"/>
                <field name="is_return_validated" invisible="1"/>
                <field name="has_pending_acknowledgement" invisible="1"/>
                <field name="show_store_request_button" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='validity_date']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>

            <!--            <xpath expr="//field[@name='contact_person_id']" position="attributes">-->
            <!--                <attribute name="required">1</attribute>-->
            <!--            </xpath>-->

            <!-- Hide original project_id in Other Info tab -->
            <xpath expr="//field[@name='project_id']" position="attributes">
                 <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="service_id" invisible="sale_or_spare != 'spare'" required="sale_or_spare == 'spare'" readonly="state == 'sale'"/>
            </xpath>

            <!-- Add project_id below GST Treatment (if l10n_in_gst_treatment exists) or in the header -->
            <xpath expr="//field[@name='l10n_in_gst_treatment']" position="after">
                <field name="project_id" groups="project.group_project_user" invisible="not project_id and state in ['sale', 'cancel']" readonly="state == 'sale'"/>
            </xpath>


            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="machine_id" column_invisible="parent.sale_or_spare != 'spare'" required="parent.sale_or_spare == 'spare'" readonly="parent.state == 'sale'"/>
            </xpath>

            <xpath expr="//page[@name='customer_signature']" position="after">
                <page name="note" string="Note">
                    <group>
                        <field name="user_note" required="sale_or_spare != 'sale'"/>
                    </group>
                </page>
                <page name="acknowledgements" string="Acknowledgements" invisible="sale_or_spare != 'spare'">
                    <field name="filtered_acknowledgement_ids" readonly="1">
                        <list decoration-warning="state == 'pending'" decoration-success="state == 'received'">
                            <field name="source_user_id" string="From"/>
                            <field name="display_dest_user" string="To"/>
                            <field name="date"/>
                            <field name="line_ids" widget="many2many_tags" string="Received Items"/>
                            <field name="state" widget="badge" decoration-warning="state == 'pending'" decoration-success="state == 'received'"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <field name="source_user_id"/>
                                    <field name="dest_user_id"/>
                                    <field name="date"/>
                                    <field name="state"/>
                                </group>
                                <field name="line_ids">
                                    <list>
                                        <field name="product_id"/>
                                        <field name="serial_numbers"/>
                                        <field name="quantity"/>
                                    </list>
                                </field>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>


        </field>
    </record>


    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="name">Sale Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="context">
            {'search_default_my_quotation': 1, 'default_sale_or_spare': 'sale'}
        </field>
        <field name="domain">[('sale_or_spare', '=', 'sale')]</field>
        <field name="help" type="html">
            <br/>
            <h2>Beat competitors with stunning quotations!</h2>
            <p>
                Boost sales with online payments or signatures, upsells,
                and a great customer portal.
            </p>
            <a role="button"
               class="btn btn-secondary"
               href="https://www.odoo.com/documentation/18.0/_downloads/312a470653db882b08ad72eb30cb4088/sample_quotation.pdf"
               target="_blank">
                Check a sample. It's clean!
            </a>
        </field>
    </record>

    <record id="action_quotations_with_spares" model="ir.actions.act_window">
        <field name="name">Spare Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="context">
            {'search_default_my_quotation': 1, 'default_sale_or_spare': 'spare'}
        </field>
        <field name="domain">[('sale_or_spare', '=', 'spare')]</field>
        <field name="help" type="html">
            <br/>
            <h2>Beat competitors with stunning quotations!</h2>
            <p>
                Boost sales with online payments or signatures, upsells,
                and a great customer portal.
            </p>
            <a role="button"
               class="btn btn-secondary"
               href="https://www.odoo.com/documentation/18.0/_downloads/312a470653db882b08ad72eb30cb4088/sample_quotation.pdf"
               target="_blank">
                Check a sample. It's clean!
            </a>
        </field>
    </record>


    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="name">Sales Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="context">{}</field>
        <field name="path">orders</field>
        <field name="domain">[('state', 'not in', ('draft', 'sent', 'cancel')) or ('sale_or_spare', '=', 'sale') ]
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new quotation, the first step of a new sale!
            </p>
            <p>
                Once the quotation is confirmed, it becomes a sales order.
                <br/>
                You will be able to create an invoice and collect the payment.
            </p>
        </field>
    </record>

    <record id="action_spare_orders" model="ir.actions.act_window">
        <field name="name">Spare Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="context">{}</field>
        <field name="domain">[('state', 'not in', ('draft', 'sent', 'cancel')) and ('sale_or_spare', '=', 'spare') ]
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new quotation, the first step of a new sale!
            </p>
            <p>
                Once the quotation is confirmed, it becomes a sales order.
                <br/>
                You will be able to create an invoice and collect the payment.
            </p>
        </field>
    </record>

    <menuitem id="sale.menu_sale_quotations"
              parent="sale.sale_order_menu"
              action="sale.action_quotations_with_onboarding"
              groups="sales_team.group_sale_salesman"
              sequence="10"/>

    <menuitem id="menu_spares_spares"
              parent="sale.sale_order_menu"
              action="action_quotations_with_spares"
              groups="sales_team.group_sale_salesman"
              sequence="11"/>

    <menuitem id="sale.menu_sale_order"
              name="Sale Orders"
              action="sale.action_orders"
              parent="sale.sale_order_menu"
              groups="sales_team.group_sale_salesman"
              sequence="20"/>

    <menuitem id="menu_spare_order"
              name="Spare Orders"
              action="action_spare_orders"
              parent="sale.sale_order_menu"
              groups="sales_team.group_sale_salesman"
              sequence="20"/>


</odoo>

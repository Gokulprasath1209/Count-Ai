<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_acknowledgement_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.acknowledgement.wizard.form</field>
        <field name="model">sale.order.acknowledgement.wizard</field>
        <field name="arch" type="xml">
            <form string="Acknowledge Receipt">
                <sheet>
                    <group>
                        <field name="order_id" readonly="1"/>
                        <field name="is_returnable" invisible="1"/>
                        <field name="is_return_to_store" invisible="not is_returnable"/>
                        <field name="dest_user_id" invisible="is_return_to_store" required="not is_return_to_store"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" create="true" delete="true">
                            <field name="product_id" options="{'no_open': True}"/>
                            <field name="serial_numbers" column_invisible="not parent.is_return_to_store" placeholder="SN1, SN2"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_team_leader_rule" model="ir.rule">
        <field name="name">Team Leader Ticket Rule</field>
        <field name="model_id" ref="model_ticket_helpdesk"/>
        <field name="groups" eval="[(4, ref('odoo_website_helpdesk.helpdesk_team_leader'))]"/>
        <field name="domain_force">
            ['|','|',
            ('assigned_user_id', '=', user.id),
            ('assigned_user_id', 'in', user.employee_id.child_ids.user_id.ids),
            ('created_by', '=', user.id)
            ]
        </field>
    </record>


    <record id="helpdesk_ticket_manager_rule" model="ir.rule">
        <field name="name">Manager Ticket Rule</field>
        <field name="model_id" ref="model_ticket_helpdesk"/>
        <field name="groups" eval="[(4, ref('odoo_website_helpdesk.helpdesk_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="helpdesk_ticket_user_rule" model="ir.rule">
        <field name="name">User Ticket Rule</field>
        <field name="model_id" ref="model_ticket_helpdesk"/>
        <field name="groups" eval="[(4, ref('odoo_website_helpdesk.helpdesk_user'))]"/>
        <field name="domain_force">
            [('assigned_user_id', '=', user.id)]
        </field>
    </record>


    <record id="help_desk_stage_rule_leader" model="ir.rule">
        <field name="name">Record Rule stages leader</field>
        <field name="model_id" ref="model_ticket_stage"/>
        <field name="groups" eval="[(4, ref('odoo_website_helpdesk.helpdesk_team_leader'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>


    <record id="help_desk_stage_rule_manager"
            model="ir.rule">
        <field name="name">Record Rule stages manager</field>
        <field ref="model_ticket_stage" name="model_id"/>
        <field name="groups"
               eval="[(4, ref('odoo_website_helpdesk.helpdesk_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="help_desk_stage_rule_user" model="ir.rule">
        <field name="name">Record Rule stages user</field>
        <field name="model_id" ref="model_ticket_stage"/>
        <field name="groups" eval="[(4, ref('odoo_website_helpdesk.helpdesk_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>

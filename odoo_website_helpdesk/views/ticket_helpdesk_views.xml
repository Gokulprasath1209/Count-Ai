<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Form view-->
    <record id="helpdesk_ticket_view_quick_create_form" model="ir.ui.view">
        <field name="name">ticket.helpdesk.quick.view.form</field>
        <field name="model">ticket.helpdesk</field>
        <field name="arch" type="xml">
            <form>
                <button name="record_voice_action"
                        string="🎤 Record Voice"
                        type="object"
                        class="btn-primary"/>
                <group>
                    <field name="subject" string="Subject"/>
                    <field name="customer_id" string="Customer"/>
                    <field name="problem_heading" string="Description"/>
                </group>
            </form>
        </field>
    </record>

    <record id="ticket_helpdesk_view_form" model="ir.ui.view">
        <field name="name">ticket.helpdesk.view.form</field>
        <field name="model">ticket.helpdesk</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <div class="o_horizontal_separator" style="margin-bottom: 10px;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <button name="action_start_timer" type="object" 
                                        string="▶ Start Timer" 
                                        class="btn btn-success"
                                        invisible="is_timer_running"/>
                                <button name="action_pause_timer" type="object" 
                                        string="⏸ Pause Timer" 
                                        class="btn btn-warning"
                                        invisible="not is_timer_running"/>
                                <field name="is_timer_running" invisible="1"/>
                                <div class="text-muted" style="font-size: 0.9em;">
                                    <i class="fa fa-clock-o"/> 
                                    <strong>Total Time:</strong> 
                                    <field name="total_time_spent" widget="float_time" nolabel="1" readonly="1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="btn-primary"
                            invisible="billable==False"/>
                    <button name="action_save_ticket" type="object" string="Create Ticket" class="btn-primary"
                            invisible="name != 'New' and name != False"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': 1}"
                           readonly="not status_bar_view"/>
                    <field name="status_bar_view" invisible="1"/>

                </header>
                <sheet>
                    <div class="alert alert-success text-center fw-bold" role="alert"
                         style="margin-bottom: 20px; font-size: 14px; padding: 12px;"
                         invisible="name == 'New' or name == False">
                        <i class="fa fa-check-circle"/>
                        Ticket
                        <field name="name" readonly="1" class="fw-bold"
                               style="display: inline; border: none; background: transparent;"/>
                        has been created successfully!!!
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_open_tasks" string="Tasks" type="object"
                                icon="fa-tasks" invisible="create_task==False"/>
                        <button class="oe_stat_button" name="action_open_merged_tickets" string="Merged Tickets"
                                type="object" icon="fa-list" invisible="merge_ticket_invisible==False">
                            <div class="o_stat_info">
                                <field name="merge_count" readonly="True"/>
                                <span class="o_stat_text">Merged Tickets</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" name="action_open_invoices" string="Invoices" type="object"
                                icon="fa-tasks" invisible="billable==False"/>
                    </div>

                    <!--                    <field name="kanban_state" widget="state_selection"/>-->

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <!--                        <label for="subject" class="oe_edit_only"/>-->
                        <!--                        <h4 class="mt0">-->
                        <!--                            <field name="subject"/>-->
                        <!--                        </h4>-->
                    </div>

                    <div class="o_horizontal_separator mt-4 mb-3"
                         style="font-size: 1.5rem; font-weight: bold; border-bottom: 1px solid #dee2e6;">Basic Details
                    </div>
                    <div class="row align-items-start">
                        <div class="col-md-3">
                            <label for="start_date" class="fw-bold d-block"/>
                            <field name="start_date" class="w-100" style="border-bottom: 1px solid #ced4da;"/>
                        </div>
                        <div class="col-md-3">
                            <label for="created_by" class="fw-bold d-block"/>
                            <field name="created_by" class="w-100" readonly="1" style="border-bottom: 1px solid #ced4da;"/>
                        </div>
                        <div class="col-md-3">
                            <label for="department" class="fw-bold d-block"/>
                            <field name="department" class="w-100" style="border-bottom: 1px solid #ced4da;"/>
                        </div>
                        <!--                        <div class="col-md-3">-->
                        <!--                            <label for="assigned_user_id" class="fw-bold d-block"/>-->
                        <!--                            <field name="assigned_user_id" class="w-100"/>-->
                        <!--                        </div>-->
                    </div>

                    <div class="o_horizontal_separator mt-4 mb-3"
                         style="font-size: 1.5rem; font-weight: bold; border-bottom: 1px solid #dee2e6;">Mill &amp;
                        Machine Details
                    </div>
                    <div class="row align-items-start">
                        <div class="col-md-3">
                            <label for="customer_id" class="fw-bold d-block"/>
                            <field name="customer_id" class="w-100" style="border-bottom: 1px solid #ced4da;"/>
                        </div>
                        <div class="col-md-2">
                            <label for="ticket_type_id" class="fw-bold d-block"/>
                            <field name="ticket_type_id" class="w-100" style="border-bottom: 1px solid #ced4da;"/>
                        </div>
                        <div class="col-md-2">
                            <label for="machine_number" class="fw-bold d-block"/>
                            <field name="machine_number" class="w-100" style="border-bottom: 1px solid #ced4da;"/>
                        </div>
                        <div class="col-md-2">
                            <label for="cabinet_version" class="fw-bold d-block"/>
                            <field name="cabinet_version" class="w-100" style="border-bottom: 1px solid #ced4da;"/>
                        </div>
                        <div class="col-md-3">
                            <label for="category_type" class="fw-bold d-block"/>
                            <field name="category_type" class="w-100" style="border-bottom: 1px solid #ced4da;"/>
                        </div>
                    </div>

                    <div class="o_horizontal_separator mt-4 mb-3"
                         style="font-size: 1.5rem; font-weight: bold; border-bottom: 1px solid #dee2e6;">Category &amp;
                        Problem
                    </div>
                    <div class="row align-items-start mb-4">
                        <div class="col-md-3">
                            <label for="category" class="fw-bold d-block"/>
                            <field name="category" class="w-100" style="border-bottom: 1px solid #ced4da;"/>
                        </div>
                        <div class="col-md-3">
                            <label for="priority" class="fw-bold d-block"/>
                            <field name="priority" class="w-100" style="border-bottom: 1px solid #ced4da;"/>
                        </div>
                        <div class="col-md-3">
                            <label for="problem_heading" class="fw-bold d-block"/>
                            <field name="problem_heading" class="w-100" style="border-bottom: 1px solid #ced4da;"/>
                        </div>
                        <div class="col-md-3">
                            <label for="camera_selection" class="fw-bold d-block"/>
                            <field name="camera_selection" class="w-100" style="border-bottom: 1px solid #ced4da;"/>
                        </div>
<!--                        <div class="col-md-3">-->
<!--                            <label for="camera_name" class="fw-bold d-block"/>-->
<!--                            <field name="camera_name" class="w-100"/>-->
<!--                        </div>-->
                    </div>

                    <div class="o_horizontal_separator mt-4 mb-3"
                         style="font-size: 1.5rem; font-weight: bold; border-bottom: 1px solid #dee2e6;">Tell The Story
                    </div>

                    <field name="show_category" invisible="1"/>
                    <field name="merge_count" invisible="1"/>
                    <field name="merge_ticket_invisible" invisible="1"/>
                    <field name="create_task" invisible="1"/>
                    <field name="billable" invisible="1"/>

                     <field name="description" placeholder="Provide the reason in detail"/>

                    <notebook>

                        <page string="Attachments">
                            <field name="ticket_ids" widget="one2many">
                                <list>
                                    <!-- Remove widget from list, just show indicator -->
                                    <field name="voice_recording" invisible="1"/>
                                    <field name="has_voice_recording" string="Voice"
                                           widget="boolean_toggle" readonly="1"/>

                                    <field name="image_upload"/>
                                    <field name="video_recording" filename="video_filename"/>
                                    <!--                                    <field name="video_filename" invisible="1"/>-->
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="voice_recording" nolabel="1"/>
                                                <field name="voice_recording" widget="audio_recorder" nolabel="1"/>
                                                <field name="image_upload"
                                                       widget="image"
                                                       class="d-block mx-auto"
                                                       style="width: 1100px; max-width: 100%; height: auto;"
                                                       options="{'zoom': true, 'preview_image': 'image_upload', 'size': [1100, 0]}"/>
                                            </group>
                                            <group>
                                                <field name="video_recording" filename="video_filename"/>
                                                <field name="video_filename" invisible="1"/>
                                                <field name="recording_duration"/>
                                                <field name="recording_date"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <page string="Time Tracking">
                            <group>
                                <group>
                                    <field name="total_time_spent" widget="float_time" readonly="1"/>
                                    <field name="timer_start" readonly="1"/>
                                    <field name="timer_pause" readonly="1" invisible="not timer_pause"/>
                                </group>
                            </group>
                            <field name="timesheet_ids">
                                <list editable="bottom">
                                    <field name="user_id" readonly="1"/>
                                    <field name="start_time" readonly="1"/>
                                    <field name="end_time" readonly="1"/>
                                    <field name="duration_display" string="Duration"/>
                                    <field name="duration" column_invisible="True"/>
                                    <field name="description"/>
                                    <field name="is_active_session" column_invisible="True"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="user_id" readonly="1"/>
                                        <field name="start_time" readonly="1"/>
                                        <field name="end_time" readonly="1"/>
                                        <field name="duration_display" string="Duration"/>
                                        <field name="duration" invisible="1"/>
                                        <field name="is_active_session" readonly="1"/>
                                        <field name="description"/>
                                    </group>
                                </form>
                            </field>
                        </page>


                        <!--                        <page string="Customer Rating">-->
                        <!--                            <group>-->
                        <!--                                <field name="customer_rating" widget="priority"/>-->
                        <!--                                <field name="review"/>-->
                        <!--                            </group>-->
                        <!--                        </page>-->

                        <!--                        <page string="Other Information">-->
                        <!--                            <group>-->
                        <!--                                <group>-->
                        <!--                                    <field name="team_id"/>-->
                        <!--                                    <field name="team_head_id"/>-->
                        <!--                                    <field name="assigned_user_id"/>-->
                        <!--                                    <field name="category_id"-->
                        <!--                                           groups="odoo_website_helpdesk.group_show_category"/>-->
                        <!--                                </group>-->
                        <!-- <group>
                             <field name="project_id"/>
                             <field name="service_product_id" required="create_task==True"/>
                             <field name="show_create_task" />
                             <field name="create_task" />
                             <field name="billable" />
                             <field name="last_update_date"/>
                             <field name="replied_date"/>
                         </group>-->
                        <!--                            </group>-->
                        <!--                        </page>-->
                    </notebook>
                </sheet>
                <div class="o_attachment_preview"/>
                <chatter/>
            </form>
        </field>
    </record>


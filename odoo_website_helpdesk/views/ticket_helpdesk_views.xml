                            <!--                            <field name="end_date"/>-->
                            <!--                            <field name="user_id"/>-->
                            <!--                            <field name="product_ids" widget="many2many_tags"/>-->
                            <field name="show_category" invisible="1"/>
                            <field name="merge_count" invisible="1"/>
                            <field name="merge_ticket_invisible" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
<!--                                                <page string="Issue Description">-->

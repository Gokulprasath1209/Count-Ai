<?xml version="1.0" encoding="UTF-8"?>
<odoo>


    <record id="view_mrpproduction_reports_wizard_form" model="ir.ui.view">
        <field name="name">mrpproduction.reports.wizard.form</field>
        <field name="model">mrpproduction.reports.wizard</field>
        <field name="arch" type="xml">
            <form string="Manufacturing Order Report">
                <sheet>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="production_type" widget="radio"/>
                        </group>
                        <group>
<!--                            <field name="user_ids" widget="many2many_tags"/>-->
                    """Prepare data for the QWeb template."""        <field name="product_ids" widget="many2many_tags"/>
                            <field name="customer_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_print_pdf"
                                string="Print PDF"
                                type="object"
                                class="oe_highlight"/>
                        <button special="cancel"
                                string="Cancel"
                                class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mrpproduction_reports_wizard_view" model="ir.actions.act_window">
        <field name="name">Manufacturing Order Report</field>
        <field name="res_model">mrpproduction.reports.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_mrpproduction_reports_wizard"
        name="Manufacturing Order Report"
        parent="mrp.menu_mrp_reporting"
        action="action_mrpproduction_reports_wizard_view"
        sequence="50"/>
</odoo>

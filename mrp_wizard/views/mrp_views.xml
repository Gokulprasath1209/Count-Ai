<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="action_regular_productions" model="ir.actions.act_window">
        <field name="name">Regular Productions</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_production_type': 'normal'}</field>
        <field name="domain">[('production_type', '=', 'normal')]</field>
    </record>


    <record id="action_spare_productions" model="ir.actions.act_window">
        <field name="name">Spare Productions</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_production_type': 'spare'}</field>
        <field name="domain">[('production_type', '=', 'spare')]</field>
    </record>



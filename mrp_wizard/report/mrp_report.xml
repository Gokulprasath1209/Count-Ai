<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="paper_format_mrp_report_pdf" model="report.paperformat">
            <field name="name">MRP Report PDF</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_spacing">10</field>
            <field name="dpi">90</field>
        </record>


        <record id="mrpproduction_reports_wizard_report_action" model="ir.actions.report">
            <field name="name">Manufacturing Report</field>
            <field name="model">mrpproduction.reports.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">mrp_wizard.template_mrp_production_report_qweb</field>
            <field name="report_file">mrp_wizard.template_mrp_production_report_qweb</field>
            <field name="paperformat_id" ref="mrp_wizard.paper_format_mrp_report_pdf"/>
        </record>


        <template id="template_mrp_production_report_qweb">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">

                    <t t-set="company" t-value="res_company"/>

                    <div class="page" style="margin-top:10px;">


                        <t t-if="res_company and res_company.logo">
                            <div style="width:200px; text-align:left; margin-bottom:20px;">
                                <img t-att-src="'data:image/png;base64,%s' % res_company.logo.decode()"
                                     style="max-height:80px; max-width:100%; display:block;"/>
                            </div>
                        </t>


                        <h2 style="text-align:center; color:#7f609d; margin-bottom:20px;">
                            Manufacturing Order Report
                        </h2>

                        <t t-set="prev_mo" t-value="None"/>

                        <t t-foreach="report_data" t-as="line">
                            <t t-if="prev_mo != line.get('mo_number')">
                                <t t-set="prev_mo" t-value="line.get('mo_number')"/>


                                <div class="mb-3" style="margin-top:15px;">
                                    <table style="border:1px solid black; border-collapse:collapse; width:100%;">
                                        <tr>
                                            <th style="border:none; padding:6px;">MO Number</th>
                                            <td style="border:none; padding:6px;">
                                                <span t-esc="line.get('mo_number')"/>
                                            </td>
                                            <th style="border:none; padding:6px;">Linked SO</th>
                                            <td style="border:none; padding:6px;">
                                                <span t-esc="line.get('linked_so')"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="border:none; padding:6px;">Product</th>
                                            <td style="border:none; padding:6px;">
                                                <span t-esc="line.get('product_code_name')"/>
                                            </td>
                                            <th style="border:none; padding:6px;">Version</th>
                                            <td style="border:none; padding:6px;">
                                                <span t-esc="line.get('product_version')"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="border:none; padding:6px;">Planned Qty</th>
                                            <td style="border:none; padding:6px;">
                                                <span t-esc="line.get('planned_qty')"/>
                                            </td>
                                            <th style="border:none; padding:6px;">Produced Qty</th>
                                            <td style="border:none; padding:6px;">
                                                <span t-esc="line.get('produced_qty')"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="border:none; padding:6px;">Start Date</th>
                                            <td style="border:none; padding:6px;">
                                                <span t-esc="line.get('start_date')"/>
                                            </td>
                                            <th style="border:none; padding:6px;">Planned Completion</th>
                                            <td style="border:none; padding:6px;">
                                                <span t-esc="line.get('planned_completion')"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="border:none; padding:6px;">Actual Completion</th>
                                            <td style="border:none; padding:6px;">
                                                <span t-esc="line.get('actual_completion')"/>
                                            </td>
                                            <th style="border:none; padding:6px;">Status</th>
                                            <td style="border:none; padding:6px;">
                                                <span t-esc="line.get('status')"/>
                                            </td>
                                        </tr>
                                    </table>


                                    <table class="table table-sm table-bordered"
                                           style="width:100%; border-collapse:collapse; margin-top:10px;">
                                        <thead style="background-color:#7f609d; color:white;">
                                            <tr>
                                                <th>BOM Item Code</th>
                                                <th>Planned Qty</th>
                                                <th>Actual Issued Qty</th>
                                                <th>Variance</th>
                                                <th>Variance %</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="report_data" t-as="line2">
                                                <t t-if="line2.get('mo_number') == prev_mo">
                                                    <tr>
                                                        <td>
                                                            <span t-esc="line2.get('bom_item_code')"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-esc="line2.get('bom_planned_qty')"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-esc="line2.get('actual_issued_qty')"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-esc="line2.get('variance')"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-esc="line2.get('variance_percent')"/>%
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </t>

                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="odoo_website_helpdesk.InlineVoiceRecorder" owl="1">
        <div class="o_inline_voice_recorder d-flex align-items-center gap-2">
            <button
                t-on-click="toggleRecording"
                t-att-class="state.recording ? 'btn btn-danger' : 'btn btn-primary'">
                <i t-att-class="state.recording ? 'fa fa-stop' : 'fa fa-microphone'"/>
                <t t-if="state.recording">
                    Stop (<t t-esc="state.timer"/>s)
                </t>
                <t t-else="">
                    Record
                </t>
            </button>
            <t t-if="state.audioURL">
                <audio
                    t-att-src="state.audioURL"
                    controls="controls"
                    class="ms-2"
                    style="height:32px;">
                </audio>
            </t>
        </div>
    </t>
</templates>

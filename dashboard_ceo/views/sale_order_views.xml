<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_forecast_warning" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.forecast.warning</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="forecast_warning" widget="html" 
                       invisible="not forecast_warning"
                       class="mb-0"/>
            </xpath>
        </field>
    </record>
</odoo>

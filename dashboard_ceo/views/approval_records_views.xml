<odoo>
    <menuitem id="menu_approval_records"
              name="Approval Records"
              parent="menu_ceo_dashboard_root"
              sequence="10"/>

    <record id="action_sale_order_approval_history" model="ir.actions.act_window">
        <field name="name">Sale Order Approval History</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('sale', 'done')), ('sale_or_spare', '=', 'sale')]</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_sale_order_approval_history"
              name="Sale Orders"
              parent="menu_approval_records"
              action="action_sale_order_approval_history"
              sequence="1"/>

    <record id="action_spare_order_approval_history" model="ir.actions.act_window">
        <field name="name">Spare Order Approval History</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('sale', 'done')), ('sale_or_spare', '=', 'spare')]</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_spare_order_approval_history"
              name="Spare Orders"
              parent="menu_approval_records"
              action="action_spare_order_approval_history"
              sequence="2"/>

    <record id="action_material_request_approval_history" model="ir.actions.act_window">
        <field name="name">Material Request Approval History</field>
        <field name="res_model">material.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('approved', 'received', 'full_approve', 'onhand_approve'))]</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_material_request_approval_history"
              name="Material Requests"
              parent="menu_approval_records"
              action="action_material_request_approval_history"
              sequence="3"/>
</odoo>

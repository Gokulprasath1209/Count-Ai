<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_tree_inherit_outward_value" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.outward.value</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="currency_id" column_invisible="True"/>
                <field name="outward_value" sum="Total Amount" decoration-bf="1" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

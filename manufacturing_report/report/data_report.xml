<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="manufacturing_report_action" model="ir.actions.report">
            <field name="name">Manufacturing Report</field>
            <field name="model">manufacturing.wizard.report</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">manufacturing_report.template_manufacturing_report_qweb</field>
            <field name="report_file">manufacturing_report.template_manufacturing_report_qweb</field>
        </record>


        <template id="template_manufacturing_report_qweb">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">

                    <div class="page">

                        <h2 style="text-align:center;">
                            Manufacturing Report
                        </h2>

                        <div id="informations" class="row mb-4">
                            <div class="col">
                                <strong>Start Date</strong>
                                <div t-esc="start_date"/>
                            </div>
                            <div class="col">
                                <strong>End Date</strong>
                                <div t-esc="end_date"/>
                            </div>
                            <div class="col">
                                <strong>Generated By</strong>
                                <div t-esc="user.name"/>
                            </div>
                        </div>

                        <table class="table table-bordered"
                               style="width:100%; border-collapse:collapse; margin-top:20px;">
                            <thead>
                                <tr>
                                    <th style="text-align:center;">#</th>
                                    <th style="text-align:center;">MO No</th>
                                    <th style="text-align:center;">SO No</th>
                                    <th style="text-align:center;">Product</th>
                                    <th style="text-align:center;">Version</th>
                                    <th style="text-align:center;">Planned Qty</th>
                                    <th style="text-align:center;">Produced Qty</th>
                                    <th style="text-align:center;">Start Date</th>
                                    <th style="text-align:center;">Planned Completion</th>
                                    <th style="text-align:center;">Actual Completion</th>
                                    <th style="text-align:center;">Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-set="l_index" t-value="1"/>

                                <t t-if="lines">
                                    <t t-foreach="lines" t-as="l">
                                        <tr>
                                            <td style="text-align:center;">
                                                <t t-esc="l_index"/>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-esc="l['mo_no']"/>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-esc="l['so_no']"/>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-esc="l['product']"/>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-esc="l['product_version']"/>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-esc="l['planned_qty']"/>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-esc="l['produced_qty']"/>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-esc="l['start_date']"/>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-esc="l['planned_completion_date']"/>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-esc="l['actual_completion_date']"/>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-esc="l['state']"/>
                                            </td>
                                        </tr>

                                        <t t-set="l_index" t-value="l_index + 1"/>
                                    </t>
                                </t>

                                <t t-else="">
                                    <tr>
                                        <td colspan="11" style="text-align:center;">
                                            No records found
                                        </td>
                                    </tr>
                                </t>

                            </tbody>
                        </table>

                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>

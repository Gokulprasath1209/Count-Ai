<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Root menu (if not already present) -->
<!--    <menuitem-->
<!--        id="menu_user_material_request_root"-->
<!--        name="User Material Requests"-->
<!--        sequence="10"-->
    />

    <!-- Wizard Form View -->
    <record id="view_material_request_reports_wizard_form" model="ir.ui.view">
        <field name="name">material.request.reports.wizard.form</field>
        <field name="model">material.request.reports.wizard</field>
        <field name="arch" type="xml">
            <form string="Material Request Report">
                <sheet>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="location_id"/>
                            <field name="product_id"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_print_pdf" string="Print PDF" type="object" class="oe_highlight"/>
                        <button special="cancel" string="Cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_material_request_reports_wizard_view" model="ir.actions.act_window">
        <field name="name">Material Request Report</field>
        <field name="res_model">material.request.reports.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_material_request_reports_wizard"
        name="Request Report"
        parent="material_request.menu_user_material_request_root"
        action="action_material_request_reports_wizard_view"
        sequence="20"
    />

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paper format -->
    <record id="paper_format_material_request_report_pdf" model="report.paperformat">
        <field name="name">Material Request Report PDF</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report action -->
    <record id="material_request_report_action" model="ir.actions.report">
        <field name="name">Material Request Report</field>
        <field name="model">material.request.reports.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">user_material_request_report.template_material_request_report_pdf</field>
        <field name="report_file">user_material_request_report.template_material_request_report_pdf</field>
        <field name="paperformat_id" ref="paper_format_material_request_report_pdf"/>
    </record>

    <!-- QWeb Template -->
    <template id="template_material_request_report_pdf" name="Material Request Report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h3 class="text-center">Material Request Report</h3>

                    <p class="text-center">
                        <strong>From:</strong>
                        <span class="mx-2" t-esc="start_date"/>
                        <strong>To:</strong>
                        <span class="mx-2" t-esc="end_date"/>
                    </p>

                    <table class="table table-bordered table-sm" style="font-size:12px;">
                        <thead style="background:#7f609d;color:white;">
                            <tr>
                                <th>Request No</th>
                                <th>Date</th>
                                <th>Requested By</th>
                                <th>Department</th>
                                <th>Location</th>
                                <th>Product</th>
                                <th>UOM</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Subtotal</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="lines">
                                <t t-foreach="lines" t-as="l">
                                    <tr>
                                        <td t-esc="l['request_no']"/>
                                        <td t-esc="l['request_date']"/>
                                        <td t-esc="l['requested_by']"/>
                                        <td t-esc="l['department']"/>
                                        <td t-esc="l['location']"/>
                                        <td t-esc="l['product']"/>
                                        <td t-esc="l['uom']"/>
                                        <td class="text-end" t-esc="l['quantity']"/>
                                        <td class="text-end" t-esc="l['unit_price']"/>
                                        <td class="text-end" t-esc="l['subtotal']"/>
                                        <td t-esc="l['state']"/>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
<!--                                    <td colspan="11" class="text-center">-->
<!--                                        No data available for selected criteria-->
<!--                                    </td>-->
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>

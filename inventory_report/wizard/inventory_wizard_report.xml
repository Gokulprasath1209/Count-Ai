<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_inventory__wizard_form" model="ir.ui.view">
            <field name="name">inventory.reports.wizard.form</field>
            <field name="model">inventory.wizard.report</field>
            <field name="arch" type="xml">
                <form string="Inventory Report">
                    <sheet>
                        <group>
                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </group>
                            <group>
                                <field name="code"/>
                                <label for="location_id"/>
                                <div class="o_row">
                                    <field name="location_id" options="{'no_create': True}"/>
                                    <button name="action_view_on_hand" type="object" string="View Stocks" class="btn-link" icon="fa-arrow-right" invisible="not location_id"/>
                                </div>
                                <field name="stock_cost" readonly="1" decoration-bf="1"/>
                            </group>
                        </group>
                        <footer>
                            <button name="action_print_pdf"
                                    string="Print PDF"
                                    type="object"
                                    class="oe_highlight"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_inventory_view" model="ir.actions.act_window">
            <field name="name">Inventory Report</field>
            <field name="res_model">inventory.wizard.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
                id="menu_inventory_reports_wizard_new"
                name="Inventory Report"
                parent="stock.menu_warehouse_report"
                action="action_inventory_view"
                sequence="60"/>


    </data>
</odoo>
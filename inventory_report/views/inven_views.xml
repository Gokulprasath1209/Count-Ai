<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_inward_stock" model="ir.actions.act_window">
        <field name="name">Incoming Stock</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_shipment_type': 'inward stock'}</field>
        <field name="domain">[('shipment_type', '=', 'inward stock')]</field>
    </record>


    <record id="action_internal_transfer" model="ir.actions.act_window">
        <field name="name">Internal Transfer</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_shipment_type': 'internal tranfer'}</field>
        <field name="domain">[('shipment_type', '=', 'internal tranfer')]</field>
    </record>


    <menuitem id="menu_inventory_shipments_root"
              name="Inventory Shipments"
              parent="stock.menu_warehouse_report"
              sequence="90"/>


    <menuitem id="menu_inward_stock"
              name="Incoming Stock"
              parent="stock.menu_warehouse_report"
              action="action_inward_stock"
              sequence="10"/>


    <menuitem id="menu_internal_transfer"
              name="Internal Transfer"
              parent="stock.menu_warehouse_report"
              action="action_internal_transfer"
              sequence="20"/>

</odoo>

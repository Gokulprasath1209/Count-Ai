<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Paper format -->
        <record id="paper_format_inventory_report_pdf" model="report.paperformat">
            <field name="name">Inventory Report PDF</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_spacing">10</field>
            <field name="dpi">90</field>
        </record>

        <!-- Report Action -->
        <record id="inventory_reports_wizard_report_action" model="ir.actions.report">
            <field name="name">Inventory Report</field>
            <field name="model">inventory.reports.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">inventory_report.template_inventory_report_qweb</field>
            <field name="report_file">inventory_report.template_inventory_report_qweb</field>
            <field name="paperformat_id" ref="inventory_report.paper_format_inventory_report_pdf"/>
        </record>

        <!-- Report Template -->
        <template id="template_inventory_report_qweb">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-set="company" t-value="res_company"/>
                    <div class="page" style="margin-top:10px;">
                        <t t-if="res_company and res_company.logo">
                            <div style="width:200px; text-align:left; margin-bottom:20px;">
                                <img t-att-src="'data:image/png;base64,%s' % res_company.logo.decode()"
                                     style="max-height:80px; max-width:100%; display:block;"/>
                            </div>
                        </t>

                        <h2 style="text-align:center; color:#7f609d; margin-bottom:20px;">Inventory Report</h2>

                        <table class="table table-sm table-bordered" style="width:100%; border-collapse:collapse;">
                            <thead style="background-color:#7f609d; color:white;">
                                <tr>
                                    <th>Picking</th>
                                    <th>Origin</th>
                                    <th>Date</th>
                                    <th>User</th>
                                    <th>Shipment Type</th>
                                    <th>Product</th>
                                    <th>Planned Qty</th>
                                    <th>Done Qty</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="report_data" t-as="line">
                                    <tr>
                                        <td>
                                            <span t-esc="line.get('picking_name')"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.get('origin')"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.get('scheduled_date')"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.get('user')"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.get('shipment_type')"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.get('product_code_name')"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="line.get('planned_qty')"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="line.get('done_qty')"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.get('state')"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="paper_format_inventory_stock_report_pdf" model="report.paperformat">
            <field name="name">Inventory Stock Report PDF</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_spacing">10</field>
            <field name="dpi">90</field>
        </record>


        <record id="inventory_stock_report_action" model="ir.actions.report">
            <field name="name">Inventory Stock Report</field>
            <field name="model">inventory.wizard.report</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">inventory_report.template_inventory_stock_report_qweb</field>
            <field name="report_file">inventory_report.template_inventory_stock_report_qweb</field>
            <field name="paperformat_id" ref="inventory_report.paper_format_inventory_stock_report_pdf"/>
        </record>

        <!-- ========================= -->
        <!-- QWeb Template -->
        <!-- ========================= -->
        <template id="template_inventory_stock_report_qweb">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">

                        <h3 style="text-align:center;">
                            <t t-if="code == 'incoming'">Inventory Inward Report</t>
                            <t t-elif="code == 'outgoing'">Inventory Outward Report</t>
                            <t t-else="">Inventory Internal Transfer Report</t>
                        </h3>

                        <!-- ================= INCOMING ================= -->
                        <t t-if="code == 'incoming'">
                            <table class="table table-bordered table-sm" style="font-size:12px;">
                                <thead style="background:#7f609d;color:white;margin-top:150px;">
                                    <tr>
                                        <th>Date</th>
                                        <th>Vendor</th>
                                        <th>Purchase No</th>
                                        <th>Product</th>
                                        <th>Qty</th>
                                        <th>UOM</th>
                                        <th>Serial</th>
                                        <th>Lot</th>
                                        <th>Reference</th>
                                        <th>Dept</th>
                                        <th>Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="lines" t-as="l">
                                        <tr>
                                            <td t-esc="l['date']"/>
                                            <td t-esc="l['vendor']"/>
                                            <td t-esc="l['purchase_no']"/>
                                            <td t-esc="l['product']"/>
                                            <td t-esc="l['qty']"/>
                                            <td t-esc="l['uom']"/>
                                            <td t-esc="l['serial']"/>
                                            <td t-esc="l['lot']"/>
                                            <td t-esc="l['reference']"/>
                                            <td t-esc="l['dept']"/>
                                            <td class="text-end" t-esc="l['price']"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- ================= OUTGOING ================= -->
                        <t t-elif="code == 'outgoing'">
                            <table class="table table-bordered table-sm" style="font-size:12px;margin-top:150px;">
                                <thead style="background:#7f609d;color:white;">
                                    <tr>
                                        <th>Date</th>
                                        <th>Customer</th>
                                        <th>Product</th>
                                        <th>Qty</th>
                                        <th>UOM</th>
                                        <th>Price</th>
                                        <th>User</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="lines" t-as="l">
                                        <tr>
                                            <td t-esc="l['date']"/>
                                            <td t-esc="l['customer']"/>
                                            <td t-esc="l['product']"/>
                                            <td t-esc="l['qty']"/>
                                            <td t-esc="l['uom']"/>
                                            <td class="text-end" t-esc="l['price']"/>
                                            <td t-esc="l['user']"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- ================= INTERNAL ================= -->
                        <t t-else="">
                            <table class="table table-bordered table-sm" style="font-size:12px;">
                                <thead style="background:#2f5597;color:white;margin-top:150px;">
                                    <tr>
                                        <th>Date</th>
                                        <th>Reference</th>
                                        <th>Product</th>
                                        <th>Qty</th>
                                        <th>Price</th>
                                        <th>Source Location</th>
                                        <th>Destination Location</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="lines" t-as="l">
                                        <tr>
                                            <td t-esc="l['date']"/>
                                            <td t-esc="l['reference']"/>
                                            <td t-esc="l['product']"/>
                                            <td t-esc="l['qty']"/>
                                            <td class="text-end" t-esc="l['price']"/>
                                            <td t-esc="l['Source Location']"/>
                                            <td t-esc="l['Destination Location']"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>

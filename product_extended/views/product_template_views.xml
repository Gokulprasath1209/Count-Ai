<odoo>
    <record id="product_template_form_erp_code_label" model="ir.ui.view">
        <field name="name">product.template.form.erp.code.label</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='default_code']" position="attributes">
                <attribute name="string">ERP Code</attribute>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">ERP Code</attribute>
            </xpath>

        </field>
    </record>
</odoo>

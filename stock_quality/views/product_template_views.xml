<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_stock_quality" model="ir.ui.view">
        <field name="name">product.template.form.inherit.stock.quality</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group[@name='group_general']" position="inside">
                <field name="quality_check"/>
            </xpath>
        </field>
    </record>
</odoo>

<odoo>
    <data>
        <record id="view_purchase_order_inherit" model="ir.ui.view">
            <field name="name">purchase.order.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="quality_test_id" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record id="view_purchase_order_inherit_for_PR" model="ir.ui.view">
            <field name="name">purchase.order.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase_requisition.purchase_order_form_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='requisition_id']" position="replace">
                    <field name="requisition_id" readonly="0"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="quality_test_from">
            <field name="name">quality.test.from</field>
            <field name="model">quality.test</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_approve" type="object" string="Approve" class="btn-primary"
                                invisible="state in ['accept','reject']"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,accept,reject"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="ref" readonly="1"/>
                                <field name="user_id" readonly="1"/>
                                <field name="type" widget="radio" options="{'horizontal': True}" readonly="1"/>
                            </group>
                            <group>
                                <field name="date_order" readonly="1" invisible="1"/>
                                <field name="date_planned" readonly="1"/>
                                <field name="lot_id" readonly="1" invisible="type != 'fg'"/>
                                <field name="Fg_ref" readonly="1" invisible="type != 'fg'"/>
                                <field name="purchase_ids" invisible="1" widget="many2many_tags"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Product For Test" name="product_for_test">
                                <field name="test_line_ids">
                                    <list string="Products" editable="bottom" create="false" delete="false">
                                        <field name="product_id" readonly="1"/>
                                        <field name="product_qty" readonly="1"/>
                                        <field name="product_uom"/>
                                        <field name="quality_accept_count"/>
                                        <field name="open_product" optional='hide'/>
                                        <button name="action_test_for_product" type="object" string="Test"
                                                class="btn-primary"/>

                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="note">
                                <group>
                                    <field name="note" required="1"/>
                                </group>
                            </page>
                        </notebook>


                    </sheet>

                    <chatter/>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="quality_test_list">
            <field name="name">quality.test.list</field>
            <field name="model">quality.test</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="ref"/>
                    <field name="user_id"/>
                    <field name="date_planned"/>
                    <field name="state" widget="badge" decoration-success="state == 'accept'"
                           decoration-danger="state == 'reject'"/>
                </list>
            </field>
        </record>

        <record id="view_quality_search" model="ir.ui.view">
            <field name="name">quality.test.search</field>
            <field name="model">quality.test</field>
            <field name="arch" type="xml">
                <search string="Quality Search">
                    <filter string="RAW" name="type" domain="[('type','=','raw')]" help="Assets in Raw Material state"/>
                    <filter string="FG" name="type" domain="[('type','=','fg')]" help="Assets in Raw Material state"/>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="quality_test_list_action_window">
            <field name="name">Quality Test</field>
            <field name="res_model">quality.test</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <br/>
                <h2>
                    Kindly Completed to Quality Tests its Using For Purchase and Manufacture!!!
                </h2>
            </field>
        </record>


        <menuitem name="Quality" id="quality_test_root_menu"
                  web_icon="stock_quality,static/description/quality_assurance.png"
                  action="quality_test_list_action_window"/>


        <record model="ir.ui.view" id="view_open_product_quality">
            <field name="name">open.product.quality.from</field>
            <field name="model">open.product.quality</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <!--                        <button name="action_approve" type="object" string="Approve" class="btn-primary"/>-->
                        <!--                        <field name="state" widget="statusbar" statusbar_visible="draft,accept,reject"/>-->
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="product_id" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="quality_ref" readonly="1"/>
                                <field name="qty" readonly="1"/>
                                <field name="quality_accept_count" force_save="1" readonly="1"/>
                                <field name="quality_test_line_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="user_id" readonly="1"/>
                                <field name="company_id" readonly="1"/>
                                <!--                                <field name="purchase_ids" invisible="1" widget="many2many_tags"/>-->
                                <!--                                <field name="quality_type" readonly="1" widget="radio" options="{'horizontal': True}"/>-->
                            </group>
                        </group>
                        <notebook>
                            <page string="Test" name="product_for_test">
                                <field name="test_line_ids">
                                    <list string="Test" editable="bottom" create="0" delete="0">
                                        <field name="product_id" readonly="1" optional="hide"/>
                                        <field name="barcode" readonly="0"/>
                                        <field name="state" widget="radio" options="{'horizontal': True}"/>
                                         <field name="feedback"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Info" name="info">
                                <group>
                                    <!--                                    <field name="info" readonly="state in ['accept','reject']"/>-->
                                </group>
                            </page>
                        </notebook>


                    </sheet>
                    <footer>
                        <button string="Save" name="save_button" type="object" class="btn-primary"/>
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                    <chatter/>
                </form>
            </field>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_machine_number_form" model="ir.ui.view">
        <field name="name">partner.machine.number.form</field>
        <field name="model">partner.machine.number</field>
        <field name="arch" type="xml">
            <form string="Machine Number">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_partner_machine_number_list" model="ir.ui.view">
        <field name="name">partner.machine.number.list</field>
        <field name="model">partner.machine.number</field>
        <field name="arch" type="xml">
            <list string="Machine Numbers">
                <field name="name"/>
                <field name="partner_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>


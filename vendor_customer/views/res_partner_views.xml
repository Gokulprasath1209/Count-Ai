    <record id="view_partner_form_machine_number" model="ir.ui.view">
        <field name="name">res.partner.form.machine.number</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="Products" name="product_id">
                    <group>
                        <field name="product_id" widget="many2many_tags"/>
<!--                        <field name="machine_number_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': False}"/>-->
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
